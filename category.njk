---
permalink: /category/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🤖 AI at Work — Center of the Sandwich</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0F1624;--navy-mid:#1E3A5F;--navy-light:#0A0F1A;--blue:#2563EB;--blue-light:#4F9CF9;--blue-bg:#EEF5FF;--blue-border:#BFDBFE;--text:#0F1624;--text-secondary:#4B6080;--text-muted:#8BA3C7;--border:#DCE8F5;--border-light:#EFF4FB;--surface:#F8FAFD;--white:#ffffff;--green:#059669;--green-bg:#ECFDF5;--amber:#D97706;--amber-bg:#FEF3C7;--purple:#7C3AED;--purple-bg:#F5F3FF;--red:#9F1239;--red-bg:#FFF1F2;--accent:#2563EB;--accent-dark:#1D4ED8;--muted:#8BA3C7}
body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);font-size:15px;line-height:1.7}
a{color:inherit;text-decoration:none}
.site-wrap{max-width:960px;margin:0 auto;padding:0 2rem}
.nav-ticker{background:var(--navy-light);color:var(--blue-light);font-size:10px;letter-spacing:2.5px;text-transform:uppercase;text-align:center;padding:7px;border-bottom:1px solid var(--navy-mid)}
.site-nav{background:var(--navy);border-bottom:1px solid var(--navy-mid);position:sticky;top:0;z-index:100}
.nav-inner{max-width:960px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:60px}
.nav-logo{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}
.nav-logo-text{font-family:'Playfair Display',serif;font-size:17px;font-weight:700;color:var(--white);white-space:nowrap}
.nav-logo-text span{color:var(--blue-light)}
.nav-links{display:flex;gap:4px;list-style:none}
.nav-links a{font-size:13px;font-weight:500;color:var(--text-muted);padding:6px 12px;border-radius:6px;text-decoration:none;transition:all .15s}
.nav-links a:hover{color:var(--white);background:rgba(79,156,249,0.12)}
.nav-links a.active{color:var(--blue-light)}
.nav-mark{flex-shrink:0}
.section-label{display:flex;align-items:center;gap:10px;font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text-muted);font-weight:600;margin-bottom:1.25rem}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}
.cat-pill{padding:7px 16px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid;cursor:pointer;transition:all .15s;text-decoration:none;display:inline-block}
.cat-pill:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(0,0,0,.08)}
.pill-ai{background:var(--blue-bg);color:#1D4ED8;border-color:var(--blue-border)}
.pill-tools{background:var(--green-bg);color:#065F46;border-color:#6EE7B7}
.pill-culture{background:var(--amber-bg);color:#92400E;border-color:#FCD34D}
.pill-news{background:var(--purple-bg);color:#5B21B6;border-color:#C4B5FD}
.pill-strat{background:var(--red-bg);color:var(--red);border-color:#FECDD3}
.pill-personal{background:#F0FDF4;color:#14532D;border-color:#86EFAC}
.card{background:var(--white);border:0.5px solid var(--border);border-radius:10px;padding:1.1rem;transition:all .15s;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--blue-light));opacity:0;transition:opacity .15s}
.card:hover::before{opacity:1}
.card:hover{border-color:#93C5FD;transform:translateY(-2px);box-shadow:0 8px 24px rgba(37,99,235,.08)}
.read-more{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--blue);text-decoration:none;transition:gap .15s}
.read-more:hover{gap:10px}
.read-more.btn{border:1.5px solid var(--blue);padding:8px 16px;border-radius:6px}
.read-more.btn:hover{background:var(--blue);color:var(--white)}
.tag{font-size:12px;background:var(--white);border:0.5px solid var(--border);border-radius:4px;padding:3px 9px;color:var(--text-secondary);cursor:pointer;transition:all .15s}
.tag:hover{border-color:var(--blue);color:var(--blue)}
.sidebar-box{background:var(--surface);border:0.5px solid var(--border);border-radius:10px;padding:1rem;margin-bottom:14px}
.sidebar-box h4{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;font-weight:600}
.nl-box{background:var(--blue-bg);border:1.5px solid var(--blue-border);border-radius:10px;padding:1.1rem}
.nl-box h4{font-size:13px;font-weight:600;color:#1E3A5F;margin-bottom:6px}
.nl-box p{font-size:12px;color:var(--text-secondary);margin-bottom:10px;line-height:1.5}
input[type="text"],input[type="email"]{width:100%;border:1px solid var(--blue-border);border-radius:6px;padding:8px 10px;font-size:13px;font-family:'Inter',sans-serif;outline:none;background:var(--white);margin-bottom:8px}
input:focus{border-color:var(--blue)}
.btn-accent{width:100%;background:var(--blue);color:var(--white);border:none;padding:9px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:background .15s}
.btn-accent:hover{background:#1D4ED8}
.about-strip{background:var(--navy);border-radius:10px;padding:1.5rem 2rem;display:flex;align-items:center;gap:20px;margin-bottom:2.5rem}
.about-avatar{width:54px;height:54px;border-radius:50%;background:var(--blue);display:flex;align-items:center;justify-content:center;color:var(--white);font-size:13px;font-weight:600;flex-shrink:0;border:2px solid var(--blue-light)}
.about-name{font-weight:600;font-size:15px;color:var(--white);margin-bottom:4px}
.about-bio{font-size:13px;color:var(--text-muted);line-height:1.5}
.about-bio a{color:var(--blue-light)}
.site-footer{border-top:1px solid var(--border);padding:1.5rem 0;margin-top:2rem}
.footer-inner{max-width:960px;margin:0 auto;padding:0 2rem;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text-muted)}
.cat-badge{display:inline-block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;padding:3px 8px;border-radius:4px;font-weight:600}
.badge-ai{background:var(--blue-bg);color:#1D4ED8}
.badge-tools{background:var(--green-bg);color:#065F46}
.badge-culture{background:var(--amber-bg);color:#92400E}
.badge-news{background:var(--purple-bg);color:#5B21B6}
.badge-strat{background:var(--red-bg);color:var(--red)}
.badge-personal{background:#F0FDF4;color:#14532D}

@media (max-width: 768px) {
  .site-wrap { padding: 0 1rem; }
  .nav-inner { padding: 0 1rem; }
  .nav-links { display: none; }
  .hero { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem 0 0; }
  .hero-title { font-size: 26px; }
  .hero-side { display: none; }
  .cards-grid { grid-template-columns: 1fr; }
  .two-col { grid-template-columns: 1fr; }
  .cats-strip { gap: 6px; }
  .cat-pill { font-size: 11px; padding: 5px 12px; }
  .news-layout { grid-template-columns: 1fr; }
  .about-layout { grid-template-columns: 1fr; }
  .belief-grid { grid-template-columns: 1fr; }
  .writing-grid { grid-template-columns: 1fr; }
  .article-title { font-size: 28px; }
  .article-wrap { padding: 1.5rem 1rem 3rem; }
  .footer-inner { flex-direction: column; gap: 8px; text-align: center; }
  .about-hero-top { flex-direction: column; text-align: center; }
  .about-hero-name { font-size: 26px; }
  .stat-grid { grid-template-columns: repeat(2, 1fr); }
  .section-label { font-size: 9px; }
}
</style>
</head>
<body>
<div class="nav-ticker">🥪 The best part of the digital workplace — delivered fresh every day</div>
<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg class="nav-mark" width="32" height="32" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="8" width="46" height="9" rx="3" fill="#4F9CF9"/><rect x="5" y="20" width="46" height="16" rx="3" fill="#1E3A5F"/><rect x="5" y="20" width="46" height="16" rx="3" fill="none" stroke="#4F9CF9" stroke-width="0.75"/><rect x="10" y="24" width="30" height="3" rx="1.5" fill="#4F9CF9" opacity="0.5"/><rect x="10" y="29" width="22" height="3" rx="1.5" fill="#10B981" opacity="0.7"/><rect x="5" y="39" width="46" height="9" rx="3" fill="#4F9CF9"/></svg>
      <span class="nav-logo-text">Center of the <span>Sandwich</span></span>
    </a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/news/">News</a></li>
      <li><a href="/category/">AI at Work</a></li>
      <li><a href="/tools/">Tools &amp; Tech</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </div>
</nav>
<div class="site-wrap">
  <div style="padding:2.5rem 0 1.5rem;border-bottom:1px solid var(--border);margin-bottom:2rem;">
    <h1 style="font-family:'Playfair Display',serif;font-size:36px;font-weight:700;margin-bottom:8px;">🤖 AI at Work</h1>
    <p style="font-size:15px;color:var(--text-secondary);">AI tools, copilots, automation and machine learning in workplace contexts.</p>
  </div>
  <div style="display:flex;flex-wrap:wrap;gap:8px;padding:1rem 0 1.5rem;border-bottom:1px solid #DCE8F5;margin-bottom:1.5rem;">
    <a href="/category/"        style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #BFDBFE;background:#EEF5FF;color:#1D4ED8;text-decoration:none;">🤖 AI at Work</a>
    <a href="/tools/"           style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #6EE7B7;background:#ECFDF5;color:#065F46;text-decoration:none;">🛠 Tools &amp; Tech</a>
    <a href="/digital-culture/" style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #FCD34D;background:#FEF3C7;color:#92400E;text-decoration:none;">💬 Digital Culture</a>
    <a href="/news/"            style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #C4B5FD;background:#F5F3FF;color:#5B21B6;text-decoration:none;">📡 Industry News</a>
    <a href="/strategy/"        style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #FECDD3;background:#FFF1F2;color:#9F1239;text-decoration:none;">📊 Strategy</a>
    <a href="/about/"           style="padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid #86EFAC;background:#F0FDF4;color:#14532D;text-decoration:none;">✍️ About DWP Insider</a>
  </div>

  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-bottom:3rem;">
    {% for post in collections.posts | reverse %}
    {% if post.data.category == "ai-at-work" %}
    <div class="card">
      <div style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;font-weight:600;color:var(--blue);margin-bottom:8px;">🤖 AI at Work</div>
      <div style="font-family:'Playfair Display',serif;font-size:18px;font-weight:700;line-height:1.35;margin-bottom:8px;"><a href="{{ post.url }}" style="color:inherit;">{{ post.data.title }}</a></div>
      <div style="font-size:13px;line-height:1.6;color:var(--text-secondary);margin-bottom:10px;">{{ post.data.excerpt }}</div>
      <div style="font-size:11px;color:var(--text-muted);">{{ post.data.readtime }} min read</div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
</div>
<footer class="site-footer">
  <div class="footer-inner">
    <span>© 2026 centerofthesandwich.com</span>
    <span>Digital Workplace · Tech · Trends · Personal</span>
  </div>
</footer>
</body>
</html>