---
news: _data/news.json
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Industry News — Center of the Sandwich</title>
<link rel="stylesheet" href="/styles.css">
<style>
.page-header { padding: 2.5rem 0 1.5rem; border-bottom: 1.5px solid var(--border); margin-bottom: 2rem; }
.page-header h1 { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 36px; margin-bottom: 8px; }
.page-header p { font-size: 15px; color: var(--text-secondary); max-width: 560px; line-height: 1.6; }
.news-layout { display: grid; grid-template-columns: minmax(0,1fr) 240px; gap: 48px; align-items: start; }
.news-block { margin-bottom: 2.5rem; }
.news-block-date { font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--text-muted); background: var(--surface); padding: 5px 10px; border-radius: 4px; display: inline-block; margin-bottom: 1rem; }
.news-item { border: 0.5px solid var(--border); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 10px; background: #fff; display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start; transition: border-color .15s; }
.news-item:hover { border-color: var(--blue); }
.news-item-top { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
.news-source-badge { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); font-weight: 500; }
.news-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-muted); }
.news-item-title { font-size: 15px; font-weight: 500; line-height: 1.4; margin-bottom: 6px; color: var(--text); display: block; }
.news-item-title:hover { color: var(--blue); }
.news-item-excerpt { font-size: 13px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px; }
.news-item-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
.ext-link { font-size: 12px; color: var(--blue); font-weight: 500; white-space: nowrap; }
.ext-link:hover { text-decoration: underline; }
.dwp-take { background: var(--blue-bg); border: 1px solid var(--border-light); border-radius: 6px; padding: 0.75rem 1rem; margin-top: 8px; }
.dwp-take-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--blue); font-weight: 500; margin-bottom: 4px; }
.dwp-take p { font-size: 13px; color: var(--text-secondary); margin: 0; line-height: 1.5; font-style: italic; }
.sidebar { position: sticky; top: 80px; }
.sidebar-section { margin-bottom: 2rem; }
.sidebar-box { background: var(--surface); border: 1px solid var(--border-light); border-radius: 8px; padding: 1rem; margin-bottom: 16px; }
.sidebar-box h4 { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 12px; }
.source-item { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; border-bottom: 0.5px solid #F0EBE0; font-size: 13px; }
.source-item:last-child { border-bottom: none; }
.source-item span { font-size: 11px; color: var(--text-muted); }
</style>
</head>
<body>

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg class="nav-mark" width="32" height="32" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="8" width="46" height="9" rx="3" fill="#4F9CF9"/><rect x="5" y="20" width="46" height="16" rx="3" fill="#1E3A5F"/><rect x="5" y="20" width="46" height="16" rx="3" fill="none" stroke="#4F9CF9" stroke-width="0.75"/><rect x="10" y="24" width="30" height="3" rx="1.5" fill="#4F9CF9" opacity="0.5"/><rect x="10" y="29" width="22" height="3" rx="1.5" fill="#10B981" opacity="0.7"/><rect x="5" y="39" width="46" height="9" rx="3" fill="#4F9CF9"/></svg>
      <span class="nav-logo-text">Center of the <span>Sandwich</span></span>
    </a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/category/">AI at Work</a></li>
      <li><a href="/tools/">Tools &amp; Tech</a></li>
      <li><a href="/news/" class="active">News</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </div>
</nav>

<div class="site-wrap">
  <div class="page-header">
    <h1>📡 Industry News</h1>
    <p>The most relevant digital workplace and enterprise tech stories, filtered through 30 years of experience. Every headline links to the original source.</p>
  </div>

  <div class="news-layout">
    <main>

      {% if news.categories["ai-at-work"] and news.categories["ai-at-work"].length > 0 %}
      <div class="news-block">
        <div class="news-block-date">🤖 AI at Work</div>
        {% for story in news.categories["ai-at-work"] %}
        <div class="news-item">
          <div>
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div><span class="news-item-age">Today</span></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}
            <div class="dwp-take"><div class="dwp-take-label">DWP Guy's take</div><p>{{ story.dwp_take }}</p></div>
            {% endif %}
          </div>
          <div class="news-item-right"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if news.categories["tools-tech"] and news.categories["tools-tech"].length > 0 %}
      <div class="news-block">
        <div class="news-block-date">🛠 Tools &amp; Tech</div>
        {% for story in news.categories["tools-tech"] %}
        <div class="news-item">
          <div>
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div><span class="news-item-age">Today</span></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}
            <div class="dwp-take"><div class="dwp-take-label">DWP Guy's take</div><p>{{ story.dwp_take }}</p></div>
            {% endif %}
          </div>
          <div class="news-item-right"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if news.categories["digital-culture"] and news.categories["digital-culture"].length > 0 %}
      <div class="news-block">
        <div class="news-block-date">💬 Digital Culture</div>
        {% for story in news.categories["digital-culture"] %}
        <div class="news-item">
          <div>
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div><span class="news-item-age">Today</span></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}
            <div class="dwp-take"><div class="dwp-take-label">DWP Guy's take</div><p>{{ story.dwp_take }}</p></div>
            {% endif %}
          </div>
          <div class="news-item-right"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if news.categories["industry-news"] and news.categories["industry-news"].length > 0 %}
      <div class="news-block">
        <div class="news-block-date">📡 Industry News</div>
        {% for story in news.categories["industry-news"] %}
        <div class="news-item">
          <div>
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div><span class="news-item-age">Today</span></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}
            <div class="dwp-take"><div class="dwp-take-label">DWP Guy's take</div><p>{{ story.dwp_take }}</p></div>
            {% endif %}
          </div>
          <div class="news-item-right"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

    </main>

    <aside class="sidebar">
      <div class="sidebar-section">
        <div class="section-label">Sources we follow</div>
        <div class="sidebar-box">
          <div class="source-item">TechCrunch <span>Tech</span></div>
          <div class="source-item">VentureBeat <span>Enterprise AI</span></div>
          <div class="source-item">SiliconAngle <span>Enterprise Tech</span></div>
          <div class="source-item">ZDNet <span>Enterprise IT</span></div>
          <div class="source-item">CIO.com <span>IT Leaders</span></div>
          <div class="source-item">Computerworld <span>Enterprise</span></div>
          <div class="source-item">Fast Company <span>Work Culture</span></div>
          <div class="source-item">WorkLife <span>Future of Work</span></div>
          <div class="source-item">Wired <span>Tech &amp; Culture</span></div>
          <div class="source-item">HR Dive <span>HR &amp; Workforce</span></div>
          <div class="source-item">Forbes Innovation <span>Business</span></div>
          <div class="source-item">The Register <span>IT News</span></div>
        </div>
      </div>
      <div class="sidebar-box" style="background:var(--blue-bg);border-color:var(--border-light);">
        <h4>Get the weekly sandwich</h4>
        <p style="font-size:13px;color:var(--text-secondary);margin-bottom:10px;line-height:1.5;">The top stories plus DWP Guy's take, every Thursday.</p>
        <input type="email" placeholder="your@email.com" style="margin-bottom:8px;">
        <button class="btn-accent" style="width:100%;">Subscribe free</button>
      </div>
    </aside>
  </div>
</div>

<footer class="site-footer">
  <div class="footer-inner">
    <span>© 2025 centerofthesandwich.com</span>
    <span>All news links to original sources. No content is reproduced.</span>
  </div>
</footer>

<script>
document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');
  });
});
</script>
</body>
</html>
