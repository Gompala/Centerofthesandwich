---
permalink: /news/
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Industry News — Center of the Sandwich</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500;600&display=swap');
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--navy:#0F1624;--navy-mid:#1E3A5F;--navy-light:#0A0F1A;--blue:#2563EB;--blue-light:#4F9CF9;--blue-bg:#EEF5FF;--blue-border:#BFDBFE;--text:#0F1624;--text-secondary:#4B6080;--text-muted:#8BA3C7;--border:#DCE8F5;--border-light:#EFF4FB;--surface:#F8FAFD;--white:#ffffff;--green:#059669;--green-bg:#ECFDF5;--amber:#D97706;--amber-bg:#FEF3C7;--purple:#7C3AED;--purple-bg:#F5F3FF;--red:#9F1239;--red-bg:#FFF1F2}
body{font-family:'Inter',sans-serif;color:var(--text);background:var(--white);font-size:15px;line-height:1.7}
a{color:inherit;text-decoration:none}
.site-wrap{max-width:960px;margin:0 auto;padding:0 2rem}
.nav-ticker{background:var(--navy-light);color:var(--blue-light);font-size:10px;letter-spacing:2.5px;text-transform:uppercase;text-align:center;padding:7px;border-bottom:1px solid var(--navy-mid)}
.site-nav{background:var(--navy);border-bottom:1px solid var(--navy-mid);position:sticky;top:0;z-index:100}
.nav-inner{max-width:960px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:72px}
.nav-logo{display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0}
.nav-logo-text{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:var(--white);white-space:nowrap;line-height:1.1}
.nav-logo-em{color:var(--blue-light);font-style:italic}
.nav-logo-sub{font-family:'Inter',sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--text-muted);margin-top:2px}
.nav-links{display:flex;gap:4px;list-style:none}
.nav-links a{font-size:12px;font-weight:500;color:var(--text-muted);padding:5px 10px;border-radius:6px;text-decoration:none;transition:all .15s}
.nav-links a:hover{color:var(--white);background:rgba(79,156,249,0.12)}
.nav-links a.active{color:var(--blue-light)}
.nav-mark{flex-shrink:0}
.page-header{padding:2.5rem 0 1rem;margin-bottom:1rem}
.page-header h1{font-family:'Playfair Display',serif;font-weight:700;font-size:36px;margin-bottom:8px}
.page-header p{font-size:15px;color:var(--text-secondary);max-width:560px;line-height:1.6}
.pill-strip{display:flex;flex-wrap:wrap;gap:8px;padding:1rem 0 1.5rem;border-bottom:1px solid var(--border);margin-bottom:1.5rem}
.pill-strip a{padding:6px 14px;border-radius:20px;font-size:12px;font-weight:500;border:1.5px solid;text-decoration:none;transition:all .15s}
.news-layout{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:48px;align-items:start}
.news-block{margin-bottom:2.5rem}
.news-block-cat{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--text-muted);background:var(--surface);padding:5px 10px;border-radius:4px;display:inline-block;margin-bottom:1rem;font-weight:600}
.news-item{border:0.5px solid var(--border);border-radius:8px;padding:1rem 1.25rem;margin-bottom:10px;background:#fff;transition:border-color .15s}
.news-item:hover{border-color:var(--blue)}
.news-item-top{display:flex;align-items:center;gap:8px;margin-bottom:5px}
.news-source-badge{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-muted);font-weight:500}
.news-dot{width:3px;height:3px;border-radius:50%;background:var(--text-muted)}
.news-item-title{font-size:15px;font-weight:500;line-height:1.4;margin-bottom:6px;color:var(--text);display:block}
.news-item-title:hover{color:var(--blue)}
.news-item-excerpt{font-size:13px;color:var(--text-secondary);line-height:1.5;margin-bottom:8px}
.ext-link{font-size:12px;color:var(--blue);font-weight:500}
.ext-link:hover{text-decoration:underline}
.dwp-take{background:var(--surface);border:1px solid var(--border-light);border-radius:6px;padding:0.75rem 1rem;margin-top:8px}
.dwp-take-label{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--blue);font-weight:500;margin-bottom:4px}
.dwp-take p{font-size:13px;color:var(--text-secondary);margin:0;line-height:1.5;font-style:italic}
.sidebar{position:sticky;top:80px}
.sidebar-box{background:var(--surface);border:0.5px solid var(--border);border-radius:10px;padding:1rem;margin-bottom:14px}
.sidebar-box h4{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--text-muted);margin-bottom:12px;font-weight:600}
.source-item{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:0.5px solid var(--border-light);font-size:13px}
.source-item:last-child{border-bottom:none}
.source-item span{font-size:11px;color:var(--text-muted)}
.site-footer{border-top:1px solid var(--border);padding:1.5rem 0;margin-top:2rem}
.footer-inner{max-width:960px;margin:0 auto;padding:0 2rem;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text-muted)}
.date-label{font-size:11px;color:var(--text-muted);margin-bottom:3px}
@media(max-width:768px){.nav-links{display:none}.news-layout{grid-template-columns:1fr}.site-wrap{padding:0 1rem}}
</style>
</head>
<body>

<div class="nav-ticker">🥪 The best part of the digital workplace — delivered fresh every day</div>

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <svg class="nav-mark" width="34" height="34" viewBox="0 0 56 56" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="8" width="46" height="9" rx="3" fill="#4F9CF9"/><rect x="5" y="20" width="46" height="16" rx="3" fill="#1E3A5F"/><rect x="5" y="20" width="46" height="16" rx="3" fill="none" stroke="#4F9CF9" stroke-width="0.75"/><rect x="10" y="24" width="30" height="3" rx="1.5" fill="#4F9CF9" opacity="0.5"/><rect x="10" y="29" width="22" height="3" rx="1.5" fill="#10B981" opacity="0.7"/><rect x="5" y="39" width="46" height="9" rx="3" fill="#4F9CF9"/></svg>
      <div>
        <div class="nav-logo-text">Center of the <em class="nav-logo-em">Sandwich</em></div>
        <div class="nav-logo-sub">Digital Workplace Intelligence</div>
      </div>
    </a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/news/" class="active">News</a></li>
      <li><a href="/category/">AI at Work</a></li>
      <li><a href="/tools/">Tools &amp; Tech</a></li>
      <li><a href="/digital-culture/">Digital Culture</a></li>
      <li><a href="/strategy/">Strategy</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </div>
</nav>

<div class="site-wrap">
  <div class="page-header">
    <h1>📡 Industry News</h1>
    <p>The most relevant digital workplace and enterprise tech stories from the last 7 days, filtered through 30 years of experience. Every headline links to the original source.</p>
  </div>

  <div class="pill-strip">
    <a href="/category/"        style="background:#EEF5FF;color:#1D4ED8;border-color:#BFDBFE;">🤖 AI at Work</a>
    <a href="/tools/"           style="background:#ECFDF5;color:#065F46;border-color:#6EE7B7;">🛠 Tools &amp; Tech</a>
    <a href="/digital-culture/" style="background:#FEF3C7;color:#92400E;border-color:#FCD34D;">💬 Digital Culture</a>
    <a href="/news/"            style="background:#F5F3FF;color:#5B21B6;border-color:#C4B5FD;">📡 Industry News</a>
    <a href="/strategy/"        style="background:#FFF1F2;color:#9F1239;border-color:#FECDD3;">📊 Strategy</a>
    <a href="/about/"           style="background:#F0FDF4;color:#14532D;border-color:#86EFAC;">✍️ About DWP Insider</a>
  </div>

  <div class="news-layout">
    <main>

      {% if news_history and news_history.length > 0 %}

        <div class="news-block">
          <div class="news-block-cat">🤖 AI at Work</div>
          {% for story in news_history | reverse %}
          {% if story.category == "ai-at-work" %}
          <div class="news-item">
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}<div class="dwp-take"><div class="dwp-take-label">DWP Insider's take</div><p>{{ story.dwp_take }}</p></div>{% endif %}
            <div style="margin-top:8px;"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
          </div>
          {% endif %}
          {% endfor %}
        </div>

        <div class="news-block">
          <div class="news-block-cat">🛠 Tools & Tech</div>
          {% for story in news_history | reverse %}
          {% if story.category == "tools-tech" %}
          <div class="news-item">
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}<div class="dwp-take"><div class="dwp-take-label">DWP Insider's take</div><p>{{ story.dwp_take }}</p></div>{% endif %}
            <div style="margin-top:8px;"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
          </div>
          {% endif %}
          {% endfor %}
        </div>

        <div class="news-block">
          <div class="news-block-cat">💬 Digital Culture</div>
          {% for story in news_history | reverse %}
          {% if story.category == "digital-culture" %}
          <div class="news-item">
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}<div class="dwp-take"><div class="dwp-take-label">DWP Insider's take</div><p>{{ story.dwp_take }}</p></div>{% endif %}
            <div style="margin-top:8px;"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
          </div>
          {% endif %}
          {% endfor %}
        </div>

        <div class="news-block">
          <div class="news-block-cat">📡 Industry News</div>
          {% for story in news_history | reverse %}
          {% if story.category == "industry-news" %}
          <div class="news-item">
            <div class="news-item-top"><span class="news-source-badge">{{ story.source }}</span><div class="news-dot"></div></div>
            <a class="news-item-title" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">{{ story.title }}</a>
            <div class="news-item-excerpt">{{ story.excerpt }}</div>
            {% if story.dwp_take %}<div class="dwp-take"><div class="dwp-take-label">DWP Insider's take</div><p>{{ story.dwp_take }}</p></div>{% endif %}
            <div style="margin-top:8px;"><a class="ext-link" href="{{ story.url }}" target="_blank" rel="noopener noreferrer">Read original ↗</a></div>
          </div>
          {% endif %}
          {% endfor %}
        </div>

      {% else %}
        <p style="color:var(--text-secondary);padding:2rem 0;">News feed updating soon. Check back shortly.</p>
      {% endif %}

    </main>

    <aside class="sidebar">
      <div class="sidebar-box">
        <h4>Sources we follow</h4>
        <div class="source-item"><a href="https://techcrunch.com/category/artificial-intelligence/" target="_blank" rel="noopener" style="color:inherit;">TechCrunch</a> <span>Tech</span></div>
        <div class="source-item"><a href="https://venturebeat.com/category/ai/" target="_blank" rel="noopener" style="color:inherit;">VentureBeat</a> <span>Enterprise AI</span></div>
        <div class="source-item"><a href="https://siliconangle.com" target="_blank" rel="noopener" style="color:inherit;">SiliconAngle</a> <span>Enterprise Tech</span></div>
        <div class="source-item"><a href="https://zdnet.com" target="_blank" rel="noopener" style="color:inherit;">ZDNet</a> <span>Enterprise IT</span></div>
        <div class="source-item"><a href="https://cio.com" target="_blank" rel="noopener" style="color:inherit;">CIO.com</a> <span>IT Leaders</span></div>
        <div class="source-item"><a href="https://computerworld.com" target="_blank" rel="noopener" style="color:inherit;">Computerworld</a> <span>Enterprise</span></div>
        <div class="source-item"><a href="https://fastcompany.com/work-life" target="_blank" rel="noopener" style="color:inherit;">Fast Company</a> <span>Work Culture</span></div>
        <div class="source-item"><a href="https://worklife.news" target="_blank" rel="noopener" style="color:inherit;">WorkLife</a> <span>Future of Work</span></div>
        <div class="source-item"><a href="https://wired.com" target="_blank" rel="noopener" style="color:inherit;">Wired</a> <span>Tech &amp; Culture</span></div>
        <div class="source-item"><a href="https://www.techrepublic.com" target="_blank" rel="noopener" style="color:inherit;">TechRepublic</a> <span>IT Pro</span></div>
        <div class="source-item"><a href="https://www.itpro.com" target="_blank" rel="noopener" style="color:inherit;">ITPro</a> <span>Enterprise IT</span></div>
        <div class="source-item"><a href="https://www.computerweekly.com" target="_blank" rel="noopener" style="color:inherit;">Computer Weekly</a> <span>IT Management</span></div>
      </div>
    </aside>
  </div>
</div>

<footer class="site-footer">
  <div class="footer-inner">
    <span>© 2026 centerofthesandwich.com</span>
    <span>Digital Workplace · Tech · Trends · Personal</span>
  </div>
</footer>

</body>
</html>
